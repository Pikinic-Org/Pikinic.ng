{
  "info": {
    "name": "Pikinic Flights API",
    "description": "Requests for debugging flight search: our own API, then SkyLink directly. Uses {{variables}} from the 'Pikinic Flights' environment — no secrets are stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Our API",
      "item": [
        {
          "name": "Search flights (pikinic-site)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const flights = pm.response.json().flights || [];",
                  "  pm.test('returns flights', () => pm.expect(flights.length).to.be.above(0));",
                  "  if (flights[0]) pm.environment.set('bookingToken', flights[0].booking_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-flights-proxy-secret", "value": "{{flightsSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"search_mode\": \"external\",\n  \"flight_type\": \"oneway\",\n  \"from\": \"LOS\",\n  \"to\": \"LHR\",\n  \"flights_departure_date\": \"2026-11-10\",\n  \"adults\": 1,\n  \"children\": 0,\n  \"infants\": 0,\n  \"class\": \"economy\",\n  \"currency\": \"NGN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/skylink/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "skylink", "search"]
            }
          }
        },
        {
          "name": "Price a flight (needs bookingToken from search)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-flights-proxy-secret", "value": "{{flightsSecret}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_token\": \"{{bookingToken}}\",\n  \"passengers\": { \"adults\": 1, \"children\": 0, \"infants\": 0 },\n  \"class\": \"economy\",\n  \"currency\": \"NGN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/skylink/price",
              "host": ["{{baseUrl}}"],
              "path": ["api", "skylink", "price"]
            }
          }
        },
        {
          "name": "Public flight offers (no secret)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/flights",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flights"]
            }
          }
        }
      ]
    },
    {
      "name": "2. SkyLink directly (raw)",
      "description": "Login allows 10 attempts a minute per IP. Do NOT add a Reserve request here — reserve creates a real airline booking and must only be called after payment.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// SkyLink can send blank lines and a BOM before the JSON, which breaks pm.response.json().",
                  "const text = pm.response.text();",
                  "console.log('first char codes:', Array.from(text.slice(0, 6)).map(c => c.charCodeAt(0)));",
                  "const start = text.indexOf('{');",
                  "if (start >= 0) {",
                  "  const body = JSON.parse(text.slice(start));",
                  "  if (body.data && body.data.access_token) {",
                  "    pm.environment.set('skylinkToken', body.data.access_token);",
                  "    pm.test('logged in, token saved', () => pm.expect(body.status).to.eql('success'));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{skylinkEmail}}\",\n  \"password\": \"{{skylinkPassword}}\",\n  \"remember_me\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{skylinkBase}}/api/login",
              "host": ["{{skylinkBase}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Search flights (SkyLink)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const text = pm.response.text();",
                  "console.log('first char codes:', Array.from(text.slice(0, 6)).map(c => c.charCodeAt(0)));",
                  "console.log('status:', pm.response.code, '| body starts:', text.slice(0, 200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{skylinkToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"search_mode\": \"external\",\n  \"flight_type\": \"oneway\",\n  \"from\": \"LOS\",\n  \"to\": \"LHR\",\n  \"flights_departure_date\": \"2026-11-10\",\n  \"adults\": 1,\n  \"children\": 0,\n  \"infants\": 0,\n  \"class\": \"economy\",\n  \"currency\": \"NGN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{skylinkBase}}/api/flights/search",
              "host": ["{{skylinkBase}}"],
              "path": ["api", "flights", "search"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Travel site",
      "item": [
        {
          "name": "Airport search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{travelBase}}/api/airports?q=lon",
              "host": ["{{travelBase}}"],
              "path": ["api", "airports"],
              "query": [{ "key": "q", "value": "lon" }]
            }
          }
        }
      ]
    }
  ]
}
