{
  "name": "pikinic-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma generate --config=prisma.bookings.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && prisma generate --config=prisma.bookings.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:admin": "tsx prisma/seed-admin.ts",
    "db:studio": "prisma studio",
    "db:bookings:migrate": "prisma migrate dev --config=prisma.bookings.config.ts",
    "db:bookings:deploy": "prisma migrate deploy --config=prisma.bookings.config.ts",
    "db:bookings:status": "prisma migrate status --config=prisma.bookings.config.ts",
    "db:bookings:studio": "prisma studio --config=prisma.bookings.config.ts",
    "guide:upload": "tsx scripts/upload-guide.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.26.0"
}
