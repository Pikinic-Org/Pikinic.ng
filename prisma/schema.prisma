generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum BlogCategory {
  TravelTips           @map("Travel Tips")
  VisaAndDocumentation @map("Visa & Documentation")
  MoneyAndFares        @map("Money & Fares")
  DestinationGuides    @map("Destination Guides")
}

enum BlogPostStatus {
  draft
  published
}

model BlogPost {
  slug        String         @id
  title       String
  excerpt     String
  category    BlogCategory
  author      String
  publishedAt DateTime
  readTime    String
  content     Json
  imageUrl    String
  status      BlogPostStatus @default(draft)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FlightOffer {
  id        String   @id @default(cuid())
  from      String
  fromCode  String
  to        String
  toCode    String
  price     Int
  tripType  String
  stops     Int
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Unlike FlightOffer, deals never carry a fixed price — they're a discount
// percentage matched against a route at live search time (see
// skylink.service.ts) and applied on top of the real SkyLink fare.
model FlightDeal {
  id              String    @id @default(cuid())
  fromCode        String
  toCode          String
  tripType        String
  discountPercent Int
  label           String?
  imageUrl        String?
  active          Boolean   @default(true)
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PackageCategory {
  Domestic
  International
  Beach
  CityBreak @map("City Break")
  Family
  Business
}

model TravelPackage {
  slug         String            @id
  destination  String
  country      String
  name         String
  categories   PackageCategory[]
  priceFrom    Int
  duration     String
  availability String
  summary      String
  headline     String
  description  String[]
  included     String[]
  excluded     String[]
  itinerary    Json?
  imageUrls    String[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Webinar {
  slug              String   @id
  title             String
  tagline           String
  coverImageUrl     String
  dateTime          DateTime
  host              String
  description       String
  agenda            Json?
  metrics           Json?
  testimonials      Json?
  registrationLabel String
  registrationUrl   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MediaItem {
  id         String   @id @default(cuid())
  url        String
  name       String
  publicId   String?
  width      Int?
  height     Int?
  bytes      Int?
  uploadedAt DateTime @default(now())
}

enum ConsultantPaymentStatus {
  pending
  paid
}

enum ConsultantReviewStatus {
  registered
  attended
  internship
}

// Sign-ups for the /travel-consultant programme. Lives in the admin
// database (not the flight-bookings one) so the dashboard reads it directly.
// Until a payment gateway is live, people pay by bank transfer and put their
// short paymentCode in the narration; an admin matches it and marks them paid.
// paymentReference and monnifyTransactionReference are from the earlier
// Monnify checkout. `programme` tells cohorts apart; rows from the first
// one-day training have none.
model TravelConsultant {
  id                          String                  @id @default(cuid())
  fullName                    String
  email                       String                  @unique
  whatsapp                    String
  city                        String
  motivation                  String?
  referralSource              String?
  programme                   String?
  paymentCode                 String?                 @unique
  paymentStatus               ConsultantPaymentStatus @default(pending)
  reviewStatus                ConsultantReviewStatus  @default(registered)
  amount                      Int
  currency                    String                  @default("NGN")
  paymentReference            String?                 @unique
  monnifyTransactionReference String?
  paidAt                      DateTime?
  adminNotes                  String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
}

// Study-abroad sign-ups from talks, events and the website (the free study
// abroad review form). One row per email: a repeat request refreshes their
// answers but keeps the original `source`, so the event that first reached
// them stays credited. downloadCount/lastDownloadAt are bumped by the signed
// download route when the optional WAEC guide bonus is offered.
// Step one of the form is deliberately short (name, email, WhatsApp, stage) so
// a QR-code sign-up takes seconds and the contact is saved immediately. Step
// two is an optional profile the lead can add afterwards; profileCompletedAt
// marks the ones who did.
model GuideLead {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  whatsapp       String
  stage          String
  qualification  String?
  fieldOfStudy   String?
  country        String?
  intake         String?
  funding        String?
  profileCompletedAt DateTime?
  // Submitting the form is the consent: the page states that Pikinic may
  // contact them, so this is true for every row the form creates.
  consent        Boolean   @default(true)
  source         String    @default("website")
  zohoLeadId     String?
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum JobStatus {
  draft
  published
}

enum JobApplicationStatus {
  new
  shortlisted
  interviewed
  rejected
  hired
}

// Roles shown on /careers. Created and edited in the admin dashboard, so the
// public pages read them from here rather than from code. `category` is one of
// the options in src/lib/constants.ts (kept as text so adding a category needs
// no migration). A job is open to applicants while it is published and
// closesAt has not passed; after that its page says applications are closed.
model Job {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  category         String
  location         String
  jobType          String
  summary          String
  description      String
  responsibilities String[]
  qualifications   String[]
  closesAt         DateTime
  status           JobStatus        @default(draft)
  applications     JobApplication[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// One row per person per job (email is stored lowercase). The CV file lives in
// Cloudinary; cvPublicId is kept so the file can be removed with the row.
model JobApplication {
  id         String               @id @default(cuid())
  jobId      String
  job        Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  address    String
  phone      String
  // Their answer to the question on the form ("Why are you a good fit for this role?").
  motivation String?
  cvUrl      String
  cvFileName String
  cvPublicId String
  status     JobApplicationStatus @default(new)
  adminNotes String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([jobId, email])
  @@index([jobId])
}
