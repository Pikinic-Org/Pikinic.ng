generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum BlogCategory {
  TravelTips           @map("Travel Tips")
  VisaAndDocumentation @map("Visa & Documentation")
  MoneyAndFares        @map("Money & Fares")
  DestinationGuides    @map("Destination Guides")
}

enum BlogPostStatus {
  draft
  published
}

model BlogPost {
  slug        String         @id
  title       String
  excerpt     String
  category    BlogCategory
  author      String
  publishedAt DateTime
  readTime    String
  content     Json
  imageUrl    String
  status      BlogPostStatus @default(draft)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FlightOffer {
  id        String   @id @default(cuid())
  from      String
  fromCode  String
  to        String
  toCode    String
  price     Int
  tripType  String
  stops     Int
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Unlike FlightOffer, deals never carry a fixed price — they're a discount
// percentage matched against a route at live search time (see
// skylink.service.ts) and applied on top of the real SkyLink fare.
model FlightDeal {
  id              String    @id @default(cuid())
  fromCode        String
  toCode          String
  tripType        String
  discountPercent Int
  label           String?
  imageUrl        String?
  active          Boolean   @default(true)
  validUntil      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum PackageCategory {
  Domestic
  International
  Beach
  CityBreak @map("City Break")
  Family
  Business
}

model TravelPackage {
  slug         String            @id
  destination  String
  country      String
  name         String
  categories   PackageCategory[]
  priceFrom    Int
  duration     String
  availability String
  summary      String
  headline     String
  description  String[]
  included     String[]
  excluded     String[]
  itinerary    Json?
  imageUrls    String[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Webinar {
  slug              String   @id
  title             String
  tagline           String
  coverImageUrl     String
  dateTime          DateTime
  host              String
  description       String
  agenda            Json?
  metrics           Json?
  testimonials      Json?
  registrationLabel String
  registrationUrl   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MediaItem {
  id         String   @id @default(cuid())
  url        String
  name       String
  publicId   String?
  width      Int?
  height     Int?
  bytes      Int?
  uploadedAt DateTime @default(now())
}

enum ConsultantPaymentStatus {
  pending
  paid
}

enum ConsultantReviewStatus {
  submitted
  approved
  rejected
}

// Student sign-ups for the /travel-consultancy programme. Lives in the admin
// database (not the flight-bookings one) so the dashboard reads it directly.
// paymentReference is what Monnify echoes back on the webhook; it is
// regenerated on every payment attempt because Monnify rejects reused
// references, so a registrant who abandons checkout can retry.
model TravelConsultant {
  id                          String                  @id @default(cuid())
  fullName                    String
  email                       String                  @unique
  whatsapp                    String
  institution                 String
  courseOfStudy               String
  levelOfStudy                String
  city                        String
  motivation                  String
  experience                  String?
  referralSource              String?
  paymentStatus               ConsultantPaymentStatus @default(pending)
  reviewStatus                ConsultantReviewStatus  @default(submitted)
  amount                      Int
  currency                    String                  @default("NGN")
  paymentReference            String?                 @unique
  monnifyTransactionReference String?
  paidAt                      DateTime?
  adminNotes                  String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
}
