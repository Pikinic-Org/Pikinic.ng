# Zoho OAuth accounts domain — depends on your Zoho data center
# (.com for US, .eu, .in, .com.au, .jp, .com.cn). Same for both apps below.
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Zoho CRM — contact form submits here as a new Lead.
# Create a Self Client / OAuth app at https://api-console.zoho.com with the
# ZohoCRM.modules.leads.CREATE scope, then generate a refresh token.
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com

# Zoho Campaigns — two separate lists, both use the same OAuth app/token.
# OAuth app needs scope ZohoCampaigns.contact.ALL — plain .CREATE is
# rejected by the listsubscribe endpoint with a 401.
ZOHO_CAMPAIGNS_CLIENT_ID=
ZOHO_CAMPAIGNS_CLIENT_SECRET=
ZOHO_CAMPAIGNS_REFRESH_TOKEN=
ZOHO_CAMPAIGNS_API_DOMAIN=https://campaigns.zoho.com

# Contact form adds name+email to this list.
ZOHO_CAMPAIGNS_LIST_KEY_CONTACT=

# Newsletter footer form subscribes the email to this list.
ZOHO_CAMPAIGNS_LIST_KEY_NEWSLETTER=

# Postgres connection string for Prisma. Local Postgres while developing;
# the Neon connection string (via Vercel's Storage tab) in production.
DATABASE_URL=

# Separate Postgres database for SkyLink flight bookings (PNRs, traveller
# data, payment references) — deliberately isolated from DATABASE_URL above,
# its own Neon project, its own credentials. Local Postgres while developing.
FLIGHTBOOKING_DB_URL=

# SkyLink (247Travels) flight search/pricing/reservation API.
# Base URL is the SkyLink API host — confirm with 247Travels which one your
# credentials are issued against (test vs production may differ).
SKYLINK_BASE_URL=
SKYLINK_EMAIL=
SKYLINK_PASSWORD=

# Shared secret required on the x-flights-proxy-secret header for the
# /api/skylink/* and /api/monnify/* routes (excluding the Monnify webhook,
# which is verified by signature instead). Generate one with:
#   openssl rand -base64 32
FLIGHTS_PROXY_SECRET=

# Monnify payment gateway. Base URL is https://sandbox.monnify.com while
# testing, https://api.monnify.com in production. Get API Key, Secret Key,
# and Contract Code from the dashboard under Developers > API Keys & Contracts.
MONNIFY_BASE_URL=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# NextAuth — random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Credentials for the one admin account created by `prisma/seed.ts`.
# No public signup route exists — this is the only way an admin account
# gets created. Change the password after first login is wired up.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary — used by the Media Library to store uploaded images.
# Get these from your Cloudinary dashboard after signing up (free tier).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Travel consultancy registration fee in NGN (defaults to 50000 if unset)
TRAVEL_CONSULTANT_FEE=50000

# WhatsApp group invite link shown on /travel-consultancy (section hidden if unset)
CONSULTANCY_WHATSAPP_GROUP_URL=
